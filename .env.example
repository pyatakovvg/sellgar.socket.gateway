# данные для http/socket подключения к socket gateway
PORT=4040
BASE_URL="http://localhost:4040"
ORIGINS="http://localhost:3000"

# данные подключения к rabbitmq
AMQP_HOSTNAME="localhost"
AMQP_PORT=5672
AMQP_USERNAME="admin"
AMQP_PASSWORD="admin"

# queue/exchange для входящих событий socket gateway
AMQP_SOCKET_GATEWAY_EVENT_QUEUE="socket_gateway.event.queue"
AMQP_SOCKET_GATEWAY_EVENT_EXCHANGE="event.exchange"

# exchange для рассылки событий по экземплярам socket gateway
AMQP_SOCKET_GATEWAY_DISPATCH_EXCHANGE="socket_gateway.dispatch.exchange"
AMQP_SOCKET_GATEWAY_DEAD_LETTER_EXCHANGE="socket_gateway.dead-letter.exchange"
AMQP_PREFETCH_COUNT=20

# данные короткоживущего socket ticket
SOCKET_TICKET_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
SOCKET_TICKET_AUDIENCE="realtime"
SOCKET_INSTANCE_ID="local-1"
REALTIME_DEDUPE_MAX_ENTRIES=10000
